generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── App models ─────────────────────────────────────────────────

// Golden image, scoped by deployment environment so a snapshot built on a
// preview deployment can't clobber the prod snapshot. `environment` is
// "production", "preview:<branch>", or "development" (see SNAPSHOT_ENVIRONMENT
// in lib/env.ts).
model Snapshot {
  id              String   @id
  environment     String   @unique
  provider        String   @default("hetzner")
  providerImageId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("snapshots")
}

enum DesiredState {
  running
  stopped
  hibernated
  deleted
}

enum ObservedState {
  pending
  provisioning
  running
  unhealthy
  lost
  stopped
  hibernating
  hibernated
  waking
  failed
  deleted
}

model Server {
  id                 String            @id
  name               String
  game               String
  location           String
  serverType         String
  provider           String            @default("hetzner")
  providerServerId   String?           @unique
  ipv4               String?
  desiredState       DesiredState      @default(running)
  observedState      ObservedState     @default(pending)
  phase              String            @default("queued")
  errorReason        String?
  rconPassword       String
  joinPassword       String?
  settings           Json              @default("{}")
  backupsEnabled     Boolean           @default(false)
  hibernationImageId String?
  hibernatedAt       DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  deletedAt          DateTime?
  agent              Agent?
  commands           Command[]
  activityEvents     ActivityEvent[]
  logChunks          LogChunk[]
  enrollments        AgentEnrollment[]

  @@index([desiredState, observedState])
  @@map("servers")
}

model Agent {
  id              String    @id
  serverId        String    @unique
  publicKey       String
  sessionVersion  Int       @default(0)
  lastHeartbeatAt DateTime?
  lastCommandId   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  server          Server    @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@map("agents")
}

model AgentEnrollment {
  jti       String    @id
  serverId  String
  expiresAt DateTime
  burnedAt  DateTime?
  createdAt DateTime  @default(now())
  server    Server    @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId])
  @@map("agent_enrollments")
}

model Command {
  id          String    @id
  serverId    String
  type        String
  payload     Json
  status      String    @default("pending")
  issuedAt    DateTime  @default(now())
  deliveredAt DateTime?
  ackedAt     DateTime?
  error       String?
  result      Json?
  durationMs  Int?
  server      Server    @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId, status])
  @@map("commands")
}

model ActivityEvent {
  id         String   @id
  serverId   String
  seq        Int
  phase      String
  message    String
  metadata   Json?
  occurredAt DateTime @default(now())
  source     String   @default("server") // "server" | "agent"
  server     Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([serverId, seq])
  @@index([serverId, occurredAt])
  @@map("activity_events")
}

model LogChunk {
  id       String   @id
  serverId String
  seq      Int
  stream   String
  line     String
  ts       DateTime @default(now())
  server   Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([serverId, seq])
  @@index([serverId, ts])
  @@map("log_chunks")
}

enum SnapshotBuildStatus {
  pending
  compiling_agent
  creating_vm
  installing
  snapshotting
  ready
  failed
}

model SnapshotBuild {
  id                 String              @id
  status             SnapshotBuildStatus @default(pending)
  agentBlobUrl       String?
  agentSha           String?
  provider           String              @default("hetzner")
  providerBuilderId  String?
  snapshotId         String?
  previousSnapshotId String?
  errorReason        String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  finishedAt         DateTime?

  @@index([createdAt(sort: Desc)])
  @@map("snapshot_builds")
}
